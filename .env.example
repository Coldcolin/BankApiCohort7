PORT=3000
# MongoDB Atlas (recommended) — replica set is included, supports ACID transactions
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/BankingApp?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
# Comma-separated allowed origins (local dev + deployed frontend/API)
# Include your API URL if you use hosted Swagger UI (Render adds RENDER_EXTERNAL_URL automatically)
CORS_ORIGIN=http://localhost:5173,https://bankapicohort7.onrender.com,https://backend-banking-api.onrender.com
BCRYPT_ROUNDS=12
